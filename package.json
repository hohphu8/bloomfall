{
  "name": "bloomfall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4186",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4186",
    "test": "node --test tests/engine.test.js",
    "test:e2e": "playwright test",
    "test:production": "playwright test -c playwright.production.config.js",
    "audit:browser": "node scripts/audit-browser.mjs",
    "check": "npm test && npm run build && npm run test:e2e && npm run test:production"
  },
  "dependencies": {
    "gyosjs": "0.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "vite": "6.4.6"
  }
}
